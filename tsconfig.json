{
	"extends": "@vue/tsconfig/tsconfig.json",
	"include": ["./src/**/*.ts", "./src/**/*.vue", "./src/**/*.d.ts"],
	"compilerOptions": {
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"allowSyntheticDefaultImports": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowJs": true,
		"declaration": false,
		"noImplicitAny": false,
		"resolveJsonModule": true,
		"strict": true
	}
}
